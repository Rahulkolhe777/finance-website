# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/research-analyst
CLIENT_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# razorpay | cashfree
PAYMENT_GATEWAY=
# sandbox | production (Cashfree)
PAYMENT_ENV=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Public URL of this API, used for gateway return links (e.g. https://api.[YOUR-DOMAIN].com)
API_PUBLIC_URL=
# GST on fees (set GST_RATE=0 until GST-registered: receipts then show no GST)
GST_RATE=18
PRICES_INCLUDE_GST=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where new-lead alerts are sent
TEAM_ALERT_EMAIL=

SMS_API_KEY=
SMS_SENDER_ID=

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
